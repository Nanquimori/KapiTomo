{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kapitomo-plugin-reports",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://nanquimori.github.io",
    "TURNSTILE_ALLOWED_HOSTNAMES": "nanquimori.github.io"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
